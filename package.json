  "scripts": {
    "start": "sh -c '. ./scripts/native-env.sh && npx expo start --dev-client'",
    "ios": "sh -c '. ./scripts/native-env.sh && npx react-native run-ios --simulator \"iPhone 17 Pro\"'",
    "ios:release": "sh -c '. ./scripts/native-env.sh && npx react-native run-ios --simulator \"iPhone 17 Pro\" --configuration Release --no-packager'",
    "android": "sh -c '. ./scripts/native-env.sh && npx react-native run-android'",
    "pods": "sh -c '. ./scripts/native-env.sh && cd ios && pod install'",
    "prebuild:ios": "sh -c '. ./scripts/native-env.sh && expo prebuild --platform ios'",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "link-media": "node scripts/link-exercise-media.mjs > database/seed_exercise_media.sql",
    "download-media": "node scripts/download-exercise-media.mjs"
  },
  "private": true
