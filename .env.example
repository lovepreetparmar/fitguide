EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Auth providers (Supabase Dashboard → Authentication → Providers):
# - Anonymous: guest mode
# - Email: register / sign-in / password reset
# - Google: social sign-in (free tier; enable in Google Cloud + Supabase)
#
# Redirect URLs (Authentication → URL configuration):
# - fitguide://auth/callback
# - fitguide://auth/reset-password
#
# If anonymous signup fails with a database error, run database/fix_anonymous_signup.sql
